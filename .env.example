# Copy to .env and edit
SECRET_KEY=change-this-to-a-long-random-string
# MySQL (production):
DATABASE_URL=mysql+pymysql://smartghar:password@localhost:3306/smartghar?charset=utf8mb4
# Leave DATABASE_URL empty to use local SQLite (smartghar.db) for quick testing

# Optional LLM API for design commentary (layout geometry never depends on it)
LLM_API_URL=https://api.anthropic.com/v1/messages
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# First admin account created by seed.py
ADMIN_EMAIL=admin@smartghar.local
ADMIN_PASSWORD=Admin@12345
